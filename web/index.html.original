        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-fold { display: inline-flex; align-items: center; gap: 6px; padding: 0; color: var(--cr-text-secondary); background: none; border: 0; cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-fold:hover .cr-vc-sec-title { color: var(--cr-text-primary); }

        /* -- 27b. the Hardware tab of a QEMU VM: CPU, Memory, Firmware & Machine, Additional Hardware (round 5) -- */
