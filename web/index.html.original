        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-hw-cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px 24px; align-items: start; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-sec-sum { font-size: 12px; color: var(--cr-text-secondary); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-topo { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(72px, auto); align-items: end; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-topo-op { padding-bottom: 6px; font-size: 14px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-total { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; min-height: 30px; padding: 0 10px; border-left: 2px solid var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-total strong { font-size: 20px; line-height: 1.1; font-weight: 600; color: var(--cr-text-primary); font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-total span { font-size: 11px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-callout { display: flex; flex-direction: column; gap: 4px; padding: 8px 10px; font-size: 12px; line-height: 1.45; color: var(--cr-text-secondary); background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-callout strong { font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-callout p { margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-group { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding-top: 12px; border-top: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-group-head { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; min-height: 24px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-group-title { margin: 0; font-size: 12px; font-weight: 600; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-group-act { margin-left: auto; height: 24px; padding: 0 8px; font-size: 12px; gap: 4px; }
