        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-meta { display: flex; flex-wrap: wrap; gap: 2px 16px; margin: 0; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-meta { display: inline-flex; align-items: baseline; gap: 5px; min-width: 0; max-width: 340px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-meta dt { color: var(--cr-text-muted); white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-meta dd { margin: 0; overflow: hidden; color: var(--cr-text-primary); white-space: nowrap; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; padding: 0 !important; background: transparent !important; border: 0 !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > button, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > .relative > button, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > a {
            display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 9px !important; font-size: 12px !important; font-weight: 500;
            color: var(--cr-text-primary) !important; background: var(--cr-bg-elevated) !important; border: 1px solid var(--cr-border-primary) !important; border-radius: 3px !important;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > button:hover:not(:disabled), body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > .relative > button:hover { background: var(--cr-bg-hover) !important; border-color: var(--cr-border-strong) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > button.cr-icon-btn { width: 26px; padding: 0 !important; justify-content: center; color: var(--cr-text-secondary) !important; background: transparent !important; border-color: transparent !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > button.cr-icon-btn:hover { color: var(--cr-text-primary) !important; background: var(--cr-bg-hover) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions > button.cr-icon-btn.cr-icon-danger:hover { color: var(--cr-error) !important; background: var(--cr-error-soft) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions svg { width: 13px; height: 13px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions .corp-dropdown { background: var(--cr-bg-elevated) !important; border-color: var(--cr-border-primary) !important; border-radius: 4px; box-shadow: var(--cr-shadow-pop) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions .corp-dropdown button { height: auto; padding: 5px 12px !important; font-size: 12.5px !important; border: 0 !important; background: none !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-actions .corp-dropdown button:hover { background: var(--cr-bg-hover) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead + .cr-tabs, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead + .corp-tab-strip { margin-top: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tabs { overflow-x: auto; overflow-y: hidden; flex-wrap: nowrap; scrollbar-width: thin; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tabs button { flex: 0 0 auto; }
