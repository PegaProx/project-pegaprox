        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-changes .cr-nn-mgmt-tag { margin-left: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-link { align-self: flex-start; padding: 0; font-size: 12px; color: var(--cr-accent); background: transparent; border: 0; text-decoration: underline; cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-diff { margin: 0; max-height: 280px; overflow: auto; padding: 8px 10px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11.5px; line-height: 1.45; white-space: pre; color: var(--cr-text-secondary); background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-dl-add { color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-dl-del { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-dl-hunk, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-dl-file { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-mgmt-line { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-state { display: flex; align-items: center; gap: 8px; padding: 18px 4px; font-size: 12.5px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-deps { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; background: var(--cr-bg-panel); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-sub { margin: 0 0 2px; font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-chain { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-op { display: inline-flex; align-items: center; font-size: 12px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-arrow svg { width: 12px; height: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-chip { display: inline-flex; align-items: center; padding: 1px 7px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11.5px; color: var(--cr-text-primary); background: var(--cr-bg-elevated); border: 1px solid var(--cr-border-primary); border-radius: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-chip-pending { border-color: var(--cr-warning); box-shadow: inset 0 -2px 0 var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-chip-mgmt { border-color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-chip-missing { color: var(--cr-text-muted); border-style: dashed; }
        /* a wide table scrolls in its own box; without the containment its width still widened the configure pane at 1024 */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-scroll { min-width: 0; overflow-x: auto; contain: inline-size; border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table { table-layout: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table td { height: auto; padding: 4px 8px !important; white-space: normal; overflow: visible; text-overflow: clip; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table thead th { padding: 0 8px !important; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table td.cr-nn-comment { max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table .cr-nn-grow > th { position: static; height: 24px; padding: 6px 8px 2px !important; text-align: left; font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--cr-text-secondary); background: var(--cr-bg-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-row-pending > td:first-child { box-shadow: inset 3px 0 0 var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-name { font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table td.cr-nn-namecell, body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table td.cr-nn-rowacts { white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-marks { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-marks .cr-nn-pend, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-marks .cr-nn-mgmt-tag { margin-left: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-addr > span { display: block; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-rowbtns { display: inline-flex; align-items: center; gap: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-rel { font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-rel > span { display: block; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-rowacts { white-space: nowrap; text-align: right; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-dsec { display: flex; flex-direction: column; gap: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-dh { margin: 0; font-size: 12px; font-weight: 600; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-dsec p, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-plain { margin: 0; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-unknown { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-ack { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; color: var(--cr-text-primary); cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-ack input { margin-top: 2px; }
        /* -- 29. hardware health and disks of a node: sensors by kind, limits and states, disk health (round 6) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-srcs { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-srcs > li { font-size: 12.5px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-srcline { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-srcs .cr-callout p { margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table th.cr-nh-num, body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nn-table td.cr-nh-num { text-align: right; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-where { font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-row-crit > td:first-child { box-shadow: inset 3px 0 0 var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-row-warn > td:first-child { box-shadow: inset 3px 0 0 var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-bad { font-style: italic; color: var(--cr-text-secondary); }
