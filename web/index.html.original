        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pagehead-actions { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
        /* the dividers are a shadow on each tile, so the empty end of a wrapped row stays a panel */
