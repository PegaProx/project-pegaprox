        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ns-tiles .cr-stat-value { white-space: normal; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ns-soft { font-size: 13px; font-weight: 500; line-height: 1.3; }
        /* the Monitor sub tab sits in a flex row: the task table scrolls inside instead of widening the page */
