        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-acts-sep { width: 1px; height: 18px; margin: 0 2px; background: var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-body { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-editing { border-color: var(--cr-accent); box-shadow: inset 3px 0 0 var(--cr-accent); }
