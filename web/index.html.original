        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-plain { margin: 0; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-hist .cr-chart-cell { height: 200px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nh-bmc-title { margin-top: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nd-ident { display: block; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nd-errs, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nd-uses { display: flex; flex-direction: column; gap: 2px; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nd-err-hard { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table.cr-nd-table td { min-width: 0; }
        /* -- 30. summary, tasks and guests of a node: health with its limits, task states and logs, the guest list (round 6) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ns { margin-bottom: 16px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-row.cr-ns-tiles { grid-template-columns: repeat(auto-fit, minmax(112px, 1fr)); }
