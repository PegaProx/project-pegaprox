        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-topo-canvas {
            position: relative; height: clamp(420px, calc(100vh - var(--cr-header-h) - var(--cr-bottom-h) - 150px), 2400px);
            overflow: hidden; cursor: grab; touch-action: none; user-select: none; outline: none;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-topo-canvas:focus-visible { outline: none !important; box-shadow: inset 0 0 0 2px var(--cr-focus); }
