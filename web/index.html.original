        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-row > .corp-overview-card .corp-overview-label { font-size: 11px; font-weight: 600; color: var(--cr-text-muted) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-row > .corp-overview-card .corp-overview-value { font-size: 19px !important; font-weight: 600 !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead {
            display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 8px 10px;
            background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px;
        }
