        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-topo { display: flex; flex-direction: column; min-width: 0; background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-topo-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px 10px; min-height: 36px; padding: 4px 6px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-topo-bar-left, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-topo-bar-right { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; min-width: 0; }
