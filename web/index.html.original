        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nt-row-warn > td:first-child { box-shadow: inset 3px 0 0 var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-seg button.cr-nt-seg-failed .cr-seg-n { color: var(--cr-error); font-weight: 600; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nt-log { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nt-log .cr-tc-log { flex: none; min-width: 0; max-width: none; height: 340px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ng-name, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ng-status { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ng-name .cr-ico svg { width: 13px; height: 13px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ng-lock { font-size: 11.5px; white-space: nowrap; }
        /* -- 31. the configuration of a node: the section card, key value grid, form field, edit bar with the pending changes, danger zone and read states every node section uses; system information, DNS, hosts file, time, certificates and syslog (round 7) -- */
