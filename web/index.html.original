        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-label { font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-value { font-size: 19px; font-weight: 600; line-height: 1.2; color: var(--cr-text-primary); font-variant-numeric: tabular-nums; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-unit { margin-left: 4px; font-size: 12px; font-weight: 400; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-sub { font-size: 11.5px; color: var(--cr-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-error .cr-stat-value { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-warning .cr-stat-value { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-bar { position: relative; height: 3px; margin: 2px 0 1px; overflow: hidden; background: var(--cr-bg-sunken); border-radius: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-bar > span { position: absolute; left: 0; top: 0; bottom: 0; background: var(--cr-success); border-radius: 2px; }
