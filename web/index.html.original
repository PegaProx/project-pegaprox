        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vm-console-btn { width: 100%; justify-content: center; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vm-facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 3px 14px; margin: 0; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vm-facts > div { display: contents; }
