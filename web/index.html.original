        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-cmp-bar > span { height: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-cmp-bar-pass { background: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-cmp-bar-fail { background: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-cmp-bar-none { background: var(--cr-text-muted); opacity: 0.55; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-fw-counts { display: flex; flex-wrap: wrap; gap: 2px 10px; font-size: 11.5px; color: var(--cr-text-secondary); font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-cmp-n-fail { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-cmp-n-none { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-fw-note { display: -webkit-box; margin: 0; overflow: hidden; font-size: 11px; color: var(--cr-warning); -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-fw-actions { display: flex; flex-wrap: wrap; gap: 4px; margin-top: auto; padding-top: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-row.cr-stat-row-flat { border: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-cmp-controls { scroll-margin-top: calc(var(--cr-header-h) + 8px); }

        /* the classic modules: same panels, type scale, controls and accent as the views above */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .corp-tab-strip { flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .corp-tab-strip > button { flex: 0 0 auto; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .toggle-switch { width: 34px; height: 18px; background: var(--cr-border-strong); border-radius: 9px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .toggle-switch::after { top: 2px; left: 2px; width: 14px; height: 14px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .toggle-switch.active { background: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .toggle-switch.active::after { left: 18px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .custom-slider::-webkit-slider-thumb { width: 14px; height: 14px; background: var(--cr-accent); box-shadow: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .custom-slider::-moz-range-thumb { width: 14px; height: 14px; background: var(--cr-accent); box-shadow: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] input[type="range"] { accent-color: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] button.bg-proxmox-orange, body[data-layout="corporate"][data-corp-variant="redesigned"] a.bg-proxmox-orange { color: var(--cr-accent-ink) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] button.bg-proxmox-orange.px-4, body[data-layout="corporate"][data-corp-variant="redesigned"] button.bg-proxmox-orange.px-3 { padding-top: 5px; padding-bottom: 5px; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main:focus { outline: none !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .bg-proxmox-card { background: var(--cr-bg-panel); border-color: var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .bg-proxmox-card.p-6 { padding: 14px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .bg-proxmox-card.p-5 { padding: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .bg-proxmox-card.p-4 { padding: 10px 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .space-y-6 > :not([hidden]) ~ :not([hidden]) { margin-top: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main h2.text-xl, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main h2.text-lg { font-size: 15px; line-height: 22px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main h3.text-lg, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main h3.text-xl { font-size: 13.5px; line-height: 20px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .bg-proxmox-card h3.text-lg.font-semibold { color: var(--cr-text-primary) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .text-3xl { font-size: 24px; line-height: 30px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main .text-2xl { font-size: 20px; line-height: 26px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main select.px-3, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main select.px-4, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main input.px-3:not([type="checkbox"]):not([type="radio"]):not([type="range"]), body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main input.px-4:not([type="checkbox"]):not([type="radio"]):not([type="range"]) {
            padding-top: 4px; padding-bottom: 4px; font-size: 12.5px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main button.border.px-3.py-2, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main button.border.px-4.py-2 { padding-top: 5px; padding-bottom: 5px; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main table:not(.cr-table) thead th { color: var(--cr-text-secondary) !important; font-size: 11.5px !important; font-weight: 600; background: var(--cr-bg-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main table:not(.cr-table) tbody tr:hover td { background: var(--cr-bg-hover); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-main button.bg-gray-700:disabled { color: var(--cr-text-muted); background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-primary); }

        /* -- 13. focus and motion -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-skip {
            position: absolute; left: 8px; top: -48px; z-index: 100; padding: 6px 10px; font-size: 12.5px; font-weight: 600;
            color: var(--cr-accent-ink); background: var(--cr-accent); border-radius: 3px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-skip:focus { top: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] button:focus-visible, body[data-layout="corporate"][data-corp-variant="redesigned"] a:focus-visible, body[data-layout="corporate"][data-corp-variant="redesigned"] input:focus-visible, body[data-layout="corporate"][data-corp-variant="redesigned"] select:focus-visible,
        body[data-layout="corporate"][data-corp-variant="redesigned"] textarea:focus-visible, body[data-layout="corporate"][data-corp-variant="redesigned"] [tabindex]:focus-visible { outline: 2px solid var(--cr-focus) !important; outline-offset: 1px !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .corp-tree-child:focus-visible, body[data-layout="corporate"][data-corp-variant="redesigned"] .corp-tree-item:focus-visible, body[data-layout="corporate"][data-corp-variant="redesigned"] .corp-tab-strip button:focus-visible,
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table tbody tr:focus-visible, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-rail-btn:focus-visible { outline-offset: -2px !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] ::-webkit-scrollbar-thumb { background: var(--cr-scroll); border-radius: 3px; }
        /* classic Corporate shrinks a pressed button to 97 %. On a wide one the release then lands beside it
           (24 px a side on the task bar at 1600 px) and the click is lost, so these stay put */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-hit:active:not(:disabled), body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-th-btn:active:not(:disabled), body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-menu-item:active:not(:disabled),
        body[data-layout="corporate"][data-corp-variant="redesigned"] .corp-ctx-item:active:not(:disabled), body[data-layout="corporate"][data-corp-variant="redesigned"] .pp-sidebar.cr-sidebar button.w-full:active:not(:disabled) { transform: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] ::-webkit-scrollbar-thumb:hover { background: var(--cr-border-strong); }
        @media (prefers-reduced-motion: reduce) {
            body[data-layout="corporate"][data-corp-variant="redesigned"] *, body[data-layout="corporate"][data-corp-variant="redesigned"] *::before, body[data-layout="corporate"][data-corp-variant="redesigned"] *::after {
                animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important; scroll-behavior: auto !important;
            }
        }

        /* -- 15. task center: the bar, the drawer under it once open, the log pane, the dialog layer -- */
        /* round 4: the bar is the header. Collapsed it sits on the status bar, open it sits on top of the drawer */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-taskcenter {
            position: fixed; left: 0; right: 0; bottom: var(--cr-status-h); z-index: 75; display: flex; flex-direction: column;
            background: var(--cr-bg-secondary);
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-open { box-shadow: 0 -10px 28px rgba(0, 0, 0, 0.28); }
        /* the lines are shadows, so the button keeps the whole bar: 32 px high and as wide as the window */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-bar {
            display: flex; align-items: center; gap: 8px; flex: 0 0 var(--cr-tc-bar-h); height: var(--cr-tc-bar-h); min-width: 0;
            box-shadow: inset 0 1px 0 var(--cr-border-primary); cursor: pointer;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-bar:hover { background: var(--cr-bg-hover); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-open .cr-tc-bar { padding-right: 8px; box-shadow: inset 0 1px 0 var(--cr-border-primary), inset 0 -1px 0 var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-hit {
            display: flex; align-items: center; gap: 12px; flex: 1 1 auto; height: 100%; min-width: 0;
            padding: 0 12px 0 10px; font: inherit; font-size: 12px; text-align: left; white-space: nowrap; overflow: hidden;
            color: var(--cr-text-secondary); background: transparent; border: 0; cursor: pointer;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-hit:focus-visible { outline-offset: -2px !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-chev { flex-shrink: 0; color: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-chev svg { width: 16px; height: 16px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-title { flex-shrink: 0; font-weight: 600; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-window { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: 11.5px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-ctl { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; cursor: default; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-latest-pct { display: inline-flex; width: 110px; flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-scope { min-width: 0; max-width: 220px; overflow: hidden; text-overflow: ellipsis; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-counts { display: inline-flex; gap: 6px; flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count {
            display: inline-flex; align-items: center; gap: 5px; height: 20px; padding: 0 7px; border-radius: 3px;
            color: var(--cr-text-secondary); background: var(--cr-neutral-soft);
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count b { font-weight: 600; color: var(--cr-text-primary); font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count-info { color: var(--cr-info); background: var(--cr-info-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count-success { color: var(--cr-success); background: var(--cr-success-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count-warning { color: var(--cr-warning); background: var(--cr-warning-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count-error { color: var(--cr-error); background: var(--cr-error-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count.cr-tc-zero { color: var(--cr-text-muted); background: transparent; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count.cr-tc-zero::before { background: var(--cr-border-strong); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-count.cr-tc-zero b { font-weight: 500; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-latest { display: inline-flex; align-items: center; justify-content: flex-end; gap: 7px; flex: 1 1 auto; min-width: 0; overflow: hidden; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-latest > span { overflow: hidden; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-drawer {
            position: relative; display: flex; flex-direction: column; min-height: 0; max-height: 80vh; padding-top: 8px;
            background: var(--cr-bg-primary); animation: cr-tc-rise 140ms ease-out;
        }
        @keyframes cr-tc-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-grip { position: absolute; top: -4px; left: 0; right: 0; z-index: 4; height: 9px; cursor: ns-resize; touch-action: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-grip::after { content: ''; position: absolute; left: 50%; top: 3px; width: 44px; height: 3px; margin-left: -22px; border-radius: 2px; background: var(--cr-border-strong); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-grip:hover::after, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-grip:focus-visible::after { background: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-grip:focus-visible { outline-offset: -3px !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"].cr-tc-resizing, body[data-layout="corporate"][data-corp-variant="redesigned"].cr-tc-resizing * { cursor: ns-resize !important; user-select: none !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-grow { flex: 1 1 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-cover { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-cover-list { left: auto; right: 0; min-width: 280px; max-height: 50vh; overflow-y: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-cover-title { padding: 4px 10px 6px; font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-cover-row { display: flex; align-items: center; gap: 8px; height: 24px; padding: 0 10px; font-size: 12px; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-cover-row .cr-muted { margin-left: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-body { display: flex; flex: 1 1 auto; gap: 6px; min-height: 0; padding: 0 8px 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-main { display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; min-height: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-main .cr-table-wrap { flex: 1 1 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-drawer .cr-table-toolbar .cr-menu { max-height: var(--cr-tc-room, 320px); overflow-y: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-filters .cr-select { max-width: 180px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-filters .cr-search-box .cr-input { width: 220px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-link {
            max-width: 100%; padding: 0; overflow: hidden; text-overflow: ellipsis; font: inherit; text-align: left;
            color: var(--cr-accent); background: none; border: 0; cursor: pointer;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-link:hover { text-decoration: underline; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-resultcell { display: flex; align-items: center; gap: 8px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-result { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-result-error { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-result-warning { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-showlog { flex-shrink: 0; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-progress { display: inline-flex; align-items: center; gap: 6px; width: 100%; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-meter {
            position: relative; flex: 1 1 auto; min-width: 40px; height: 5px; overflow: hidden; border-radius: 3px;
            background: var(--cr-bg-sunken); box-shadow: inset 0 0 0 1px var(--cr-border-secondary);
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-meter > span { position: absolute; top: 0; bottom: 0; left: 0; border-radius: 3px; background: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-meter-busy > span { width: 35%; animation: cr-tc-busy 1.4s ease-in-out infinite; }
        @keyframes cr-tc-busy { from { left: -35%; } to { left: 100%; } }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-pct { flex-shrink: 0; font-size: 11px; color: var(--cr-text-secondary); font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log {
            display: flex; flex-direction: column; flex: 0 0 42%; min-width: 320px; max-width: 760px; min-height: 0;
            background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-head { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; height: 34px; padding: 0 6px 0 10px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-meta { display: flex; flex-wrap: wrap; gap: 4px 14px; padding: 6px 10px; font-size: 11.5px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-meta .cr-tc-result { max-width: 100%; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-progress { display: flex; align-items: center; gap: 10px; padding: 0 10px 6px; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-progress .cr-tc-progress { max-width: 260px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-body {
            flex: 1 1 auto; min-height: 0; margin: 0 10px 10px; padding: 8px; overflow: auto; white-space: pre-wrap; word-break: break-word;
            font-family: var(--font-mono); font-size: 11.5px; line-height: 1.45; color: var(--cr-text-primary);
            background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log-body.cr-state-error { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-layer { position: fixed; inset: 0; z-index: 85; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-dialog-progress { padding: 10px 16px 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-dialog-progress .cr-tc-progress { max-width: 360px; }
        /* the bar is in front of the dialogs, and they end above it, so nothing of a dialog lies under it */
        body[data-layout="corporate"][data-corp-variant="redesigned"][data-cr-tasks="1"] .corp-vm-modal-overlay, body[data-layout="corporate"][data-corp-variant="redesigned"][data-cr-tasks="1"] .fixed.inset-0.flex.items-center.justify-center { bottom: var(--cr-bottom-h); }
        body[data-layout="corporate"][data-corp-variant="redesigned"][data-cr-tasks="1"] .cr-tc-layer .fixed.inset-0.flex.items-center.justify-center { bottom: 0; }
        /* the tabs of two or more open consoles sit on the bar, not under it (their bottom: 0 is inline) */
        body[data-layout="corporate"][data-corp-variant="redesigned"][data-cr-tasks="1"] .cr-console-tabs { bottom: var(--cr-bottom-h) !important; }
        @media (prefers-reduced-motion: reduce) {
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-drawer, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-meter-busy > span { animation: none !important; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-meter-busy > span { left: 0; width: 100%; opacity: 0.45; }
        }

        /* -- 16. datastores: the Browse tab (storages left, content right) and the sidebar rows -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds { position: relative; display: flex; gap: 8px; min-height: 320px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-probe { position: absolute; top: 0; left: 0; width: 0; height: var(--cr-bottom-h); visibility: hidden; pointer-events: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side {
            display: flex; flex-direction: column; flex: 0 0 320px; min-width: 260px; min-height: 0;
            background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side-head { display: flex; align-items: center; gap: 6px; min-height: 34px; padding: 4px 6px 4px 10px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side-head .cr-table-title { flex: 0 0 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side-filter { padding: 6px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side-filter .cr-search-box { display: flex; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side-filter .cr-search-box .cr-input { flex: 1 1 auto; width: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side-foot { padding: 4px 6px; border-top: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-toggle {
            display: inline-flex; align-items: center; gap: 5px; height: 24px; margin-left: auto; padding: 0 8px;
            font-size: 12px; color: var(--cr-text-secondary); background: transparent; cursor: pointer;
            border: 1px solid var(--cr-border-primary); border-radius: 3px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-toggle:hover { color: var(--cr-text-primary); background: var(--cr-bg-hover); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-toggle.active { color: var(--cr-warning); background: var(--cr-warning-soft); border-color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-count { font-size: 11px; color: var(--cr-text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-list { position: relative; flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--cr-scroll) transparent; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-none { display: flex; align-items: center; justify-content: center; padding: 16px; font-size: 12px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-list-in { position: relative; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-row { position: absolute; left: 0; right: 0; display: flex; align-items: center; gap: 6px; min-width: 0; padding: 0 8px; cursor: pointer; outline-offset: -2px !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-row:hover { background: var(--cr-bg-hover); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-group { font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-muted); border-top: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-group:first-child { border-top: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-group .cr-ico svg { width: 13px; height: 13px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-group-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-group-n { font-size: 10.5px; font-weight: 500; letter-spacing: 0; font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-group-off .cr-ds-group-name { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-group-flag { flex-shrink: 0; font-size: 10.5px; font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-chev { width: 12px; height: 12px; flex-shrink: 0; transition: transform 0.12s ease; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-chev-open { transform: rotate(90deg); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-store { flex-direction: column; align-items: stretch; justify-content: center; gap: 3px; padding: 0 8px 0 26px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-host, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-note { padding-left: 26px; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-note { color: var(--cr-text-muted); cursor: default; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-note:hover { background: transparent; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-sel, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-sel:hover { background: var(--cr-bg-selected); box-shadow: inset 2px 0 0 var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-line { display: flex; align-items: center; gap: 6px; min-width: 0; height: 17px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-line2 { height: 15px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-ico svg { width: 13px; height: 13px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-name { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; font-weight: 500; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-unavail .cr-ds-name { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-badges { display: inline-flex; flex-shrink: 0; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-store .cr-badge { height: 16px; padding: 0 5px; font-size: 10.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-warn { display: inline-flex; flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-warn svg { width: 13px; height: 13px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-type { flex-shrink: 0; font-family: var(--font-mono) !important; font-size: 11px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap { display: inline-flex; align-items: center; gap: 8px; flex: 1 1 auto; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-line2 { padding-left: 19px; }
        /* an auto-width meter needs a real track width: Firefox leaves the flex basis out of its size */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap .cr-meter { flex: 0 0 auto; width: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap .cr-meter-track { flex: 0 0 44px; width: 44px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap-text, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap-free { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-mono) !important; font-size: 11px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap-free { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-nostats { flex: 1 1 auto; font-size: 11px; font-style: italic; color: var(--cr-text-muted); }
        @media (max-width: 1440px) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side { flex-basis: 300px; } }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-main { display: flex; flex-direction: column; gap: 8px; flex: 1 1 auto; min-width: 0; min-height: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-main > .cr-table-wrap { flex: 1 1 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-main .cr-table-scroll { overscroll-behavior: contain; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-head {
            display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; flex: 0 0 auto;
            padding: 8px 10px; background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-head-main { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-head-ico svg { width: 16px; height: 16px; color: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-title { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; font-weight: 600; line-height: 22px; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-where { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-head-side { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-left: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-head-cap { display: inline-flex; align-items: center; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap-wide .cr-meter-track { flex-basis: 140px; width: 140px; max-width: 140px; height: 6px; border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap-wide .cr-meter-val { font-size: 12.5px; font-weight: 600; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap-wide .cr-ds-cap-text { font-size: 12px; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-actions { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-spin svg { animation: cr-spin 0.8s linear infinite; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-empty {
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; flex: 1 1 auto;
            font-size: 12.5px; color: var(--cr-text-muted); background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-empty svg { width: 28px; height: 28px; opacity: 0.6; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-chips { flex-wrap: wrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-vol { display: inline-flex; align-items: center; gap: 6px; min-width: 0; max-width: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-vol .cr-ico svg { width: 13px; height: 13px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-volname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-owner { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-owner .cr-link { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-lock svg { width: 13px; height: 13px; color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table td .cr-ds-del { width: 20px; height: 20px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table td .cr-ds-del:hover { color: var(--cr-error); background: var(--cr-error-soft); }
        /* the datastore view of the sidebar */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-tree-head { display: flex; align-items: center; gap: 6px; padding: 2px 4px; margin-top: 2px; font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-tree-off { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidebar .cr-ds-node { display: flex; align-items: center; gap: 6px; min-width: 0; padding: 2px 6px 2px 4px; font-size: 12.5px; line-height: 18px; color: var(--cr-text-secondary); cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidebar .cr-ds-node:hover { color: var(--cr-text-primary); background: var(--cr-bg-hover); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidebar .cr-ds-node-sel, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidebar .cr-ds-node-sel:hover { color: var(--cr-text-primary); background: var(--cr-bg-selected); box-shadow: inset 2px 0 0 var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-node .cr-dot { flex-shrink: 0; width: 7px; height: 7px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-node-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-node-off .cr-ds-node-name { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-node-flag { flex-shrink: 0; font-size: 10.5px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-mini { display: inline-flex; flex: 0 0 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-mini .cr-meter { gap: 5px; width: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-mini .cr-meter-track { flex: 0 0 34px; width: 34px; max-width: 34px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-mini .cr-meter-val { min-width: 28px; font-size: 10.5px; }

        /* -- 17. the side panel, callout tones, and config drift (round 3) -- */
        /* one detail panel for every module: right side, between the header and the bottom bars, so the
           task bar stays reachable; under the dialogs (z 50) and the task center (75), over the event log */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidepanel {
            position: fixed; top: var(--cr-header-h); right: 0; bottom: var(--cr-bottom-h); z-index: 45;
            display: flex; flex-direction: column; width: clamp(360px, 38vw, 560px); max-width: calc(100vw - 16px);
            color: var(--cr-text-primary); background: var(--cr-bg-panel); border-left: 1px solid var(--cr-border-strong);
            box-shadow: -12px 0 28px rgba(0, 0, 0, 0.28); animation: cr-sp-in 140ms ease-out;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidepanel:focus { outline: none !important; }
        @keyframes cr-sp-in { from { transform: translateX(18px); opacity: 0; } to { transform: none; opacity: 1; } }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sp-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; flex: 0 0 auto; padding: 9px 10px 8px 14px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sp-titles { min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sp-title { margin: 0; font-size: 14px; font-weight: 600; line-height: 20px; color: var(--cr-text-primary); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sp-sub { margin-top: 1px; font-size: 11.5px; color: var(--cr-text-muted); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sp-body { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 10px 14px 14px; overscroll-behavior: contain; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sp-foot { position: sticky; bottom: 0; flex: 0 0 auto; padding: 8px 14px; background: var(--cr-bg-secondary); border-top: 1px solid var(--cr-border-secondary); }
        @media (max-width: 1366px) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidepanel { width: clamp(340px, 38vw, 480px); } }
        @media (max-width: 820px) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidepanel { top: 0; z-index: 55; width: 100vw; max-width: 100vw; } }
        @media (prefers-reduced-motion: reduce) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidepanel { animation: none !important; } }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout-info { background: var(--cr-info-soft); border-color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout-info > svg { color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout-error { background: var(--cr-error-soft); border-color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout-error > svg { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout-success { background: var(--cr-success-soft); border-color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout-success > svg { color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout > div, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout > p { flex: 1 1 auto; min-width: 0; margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-callout-close { margin: -4px -6px -4px 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-meter.cr-tone-info .cr-meter-fill { background: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-meter.cr-tone-neutral .cr-meter-fill { background: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-btn-xs { height: 20px; padding: 0 7px; gap: 4px; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-btn-xs .cr-ico svg { width: 12px; height: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-btn-xs.cr-btn-danger { padding: 0 5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-switch { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cr-text-secondary); cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-switch input { width: 14px; height: 14px; margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-switch input:disabled, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-switch input:disabled + span { cursor: not-allowed; opacity: 0.6; }

        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift .cr-stat-row.cr-drift-stats { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift [data-cr-stat="scan"] .cr-stat-value { font-size: 14px; line-height: 26px; font-family: var(--font-mono) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift-wait { display: flex; align-items: center; gap: 8px; padding: 14px 12px; font-size: 12.5px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift-overview .cr-panel-body { padding: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift-kinds { display: grid; grid-template-columns: repeat(auto-fill, minmax(232px, 1fr)); gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift-card {
            display: flex; flex-direction: column; gap: 5px; min-width: 0; padding: 8px 10px 8px 12px; font: inherit; text-align: left;
            color: var(--cr-text-primary); background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px;
            box-shadow: inset 3px 0 0 var(--cr-drift-tone, var(--cr-border-strong)); cursor: pointer;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift-card:hover { background: var(--cr-bg-hover); border-color: var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-drift-card.active { border-color: var(--cr-accent); background: var(--cr-accent-soft); }
