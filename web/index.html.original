        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-perf .cr-panel-actions { flex-wrap: wrap; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-range button { height: 22px; padding: 0 8px; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-perf-state { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 96px; font-size: 12.5px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-perf-error { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-cell { min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-wide { grid-column: 1 / -1; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-cell > div { height: 100%; padding: 8px 10px 6px !important; background: var(--cr-bg-sunken) !important; border: 1px solid var(--cr-border-secondary); border-radius: 3px !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-cell > div > div:first-child > span { font-size: 12px !important; font-weight: 600; color: var(--cr-text-secondary) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-none { display: flex; flex-direction: column; gap: 6px; min-height: 120px; padding: 8px 10px;
            background: var(--cr-bg-sunken); border: 1px dashed var(--cr-border-primary); border-radius: 3px; font-size: 12px; }
