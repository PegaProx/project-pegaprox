        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-result-head { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; font-size: 12.5px; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-result-head .cr-icon-btn { margin-left: auto; width: 22px; height: 22px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-result-sum { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-res-row { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; padding: 3px 0; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-other-list { display: grid; grid-template-columns: minmax(110px, max-content) minmax(0, 1fr); gap: 0; margin: 0; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-other-row { display: contents; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-other-row dt, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-other-row dd { margin: 0; padding: 4px 8px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-other-row dt { color: var(--cr-text-secondary); }
