        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-ch-from { color: var(--cr-error); text-decoration: line-through; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-ch-to { color: var(--cr-success); font-weight: 500; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-ch-none { text-decoration: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-ch-arrow { display: inline-flex; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-diffsum { margin: 0; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-danger { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; padding: 10px 12px; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-left: 3px solid var(--cr-error); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-danger-text { flex: 1 1 260px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-danger-title { margin: 0 0 2px; display: flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-danger-desc { margin: 0; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-danger-acts { display: flex; gap: 6px; margin-left: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-callout:not(.cr-callout-error):not(.cr-callout-warning) { color: var(--cr-text-secondary); background: var(--cr-bg-sunken); border-color: var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-callout p { margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-linebox { min-width: 0; max-height: 420px; overflow: auto; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-lines { margin: 0; padding: 6px 0; list-style: none; counter-reset: cr-nc-line; font-family: var(--font-mono); font-size: 12px; line-height: 1.55; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-lines > li { display: flex; counter-increment: cr-nc-line; padding-right: 10px; white-space: pre; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-lines > li::before { content: counter(cr-nc-line); flex: 0 0 auto; width: 3.4em; margin-right: 10px; padding-right: 8px; text-align: right; color: var(--cr-text-muted); border-right: 1px solid var(--cr-border-secondary); user-select: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-lines > li.cr-nc-line-comment { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-log { max-height: 520px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-log .cr-nc-lines > li { padding-left: 10px; white-space: pre-wrap; overflow-wrap: anywhere; }
        /* a log shown newest first, perhaps filtered, has no line numbers that mean anything */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-log .cr-nc-lines > li::before { display: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-toolbar .cr-search-box .cr-input { width: 260px; max-width: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-items { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-item { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 10px 12px; background: var(--cr-bg-secondary); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-item-head { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-item-name { font-weight: 600; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-chips { display: inline-flex; flex-wrap: wrap; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-note { margin: 0; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-confirm { display: flex; flex-direction: column; gap: 8px; font-size: 12.5px; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-confirm p { margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-warn { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-icon-btn.cr-nc-danger-ico:hover, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-icon-btn.cr-nc-danger-ico:focus-visible { color: var(--cr-error); background: var(--cr-error-soft); }
        @container (min-width: 860px) {
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-sum-cols { grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr); }
        }

        /* -- 32. storage, repositories and Ceph of a node (cr_nodestore.js): usage bars, volume group and pool cards, the update channel, pending repository switches, Ceph health checks -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-usage { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; min-width: 0; max-width: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-bar { position: relative; flex: 0 0 auto; width: 120px; max-width: 40vw; height: 6px; overflow: hidden; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-bar > span { position: absolute; left: 0; top: 0; bottom: 0; background: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-tone-warning .cr-nv-bar > span { background: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-tone-error .cr-nv-bar > span { background: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-tone-info .cr-nv-bar > span, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-tone-neutral .cr-nv-bar > span { background: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-usage-text { font-size: 12px; color: var(--cr-text-primary); font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-table .cr-nv-bar { width: 64px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-item-acts { display: inline-flex; gap: 6px; margin-left: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-item.cr-nv-open { border-color: var(--cr-accent); box-shadow: inset 3px 0 0 var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-item.cr-nv-pending { border-color: var(--cr-warning); box-shadow: inset 3px 0 0 var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-item-head .cr-nn-pend { margin-left: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-item-head { font-size: 13px; line-height: 20px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-pvs { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-pvs > li { display: flex; flex-wrap: wrap; gap: 2px 10px; min-width: 0; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-pvs .cr-muted { font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-groups { grid-template-columns: minmax(0, 1fr); gap: 14px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-channel { display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-checks { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nv-checks > li { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; min-width: 0; font-size: 12.5px; color: var(--cr-text-primary); overflow-wrap: anywhere; }

        /* -- 33. one rule set for the preview (round 8): the node count of the dashboard names the clusters it leaves out, on a second line where the tile is narrow; the members state of a balancing group, one badge per kind -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] [data-cr-summary] [data-cr-stat="nodes"] .cr-stat-sub { white-space: normal; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sb-states { display: inline-flex; flex-wrap: wrap; gap: 3px; max-width: 100%; }

        /* -- 34. decisions before the push (round 8): Apply on the management path is confirmed by typing the node name; the reason above the repositories that cannot be switched -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-typename { display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-typename .cr-input { width: 100%; max-width: 280px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] [data-cr-nr-why] { margin: 0; }

        /* -- 14. phones: the drawer and the wrapped header of #189 stay as they are -- */
        @media (max-width: 820px) {
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-header { flex-wrap: wrap; height: auto; padding: 6px 8px; row-gap: 6px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-header-left, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-header-right { flex: 1 1 100%; flex-wrap: wrap; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-header-search { flex: 1 1 100%; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-header-search input { width: 100% !important; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-crumbs, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-kbd-hint, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-header-divider, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-side-handle, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-rail { display: none; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidebar-folded > .sticky { display: block !important; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidebar > .sticky { top: 0 !important; max-height: none !important; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-latest, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-scope { display: none; }
            /* the classic rule above puts the task bar at the end of the page */
            body[data-layout="corporate"][data-corp-variant="redesigned"][data-cr-tasks="1"] { --cr-bottom-h: var(--cr-status-h); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-drawer { max-height: none; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-body { flex-wrap: wrap; height: auto; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-open .cr-tc-bar { flex-wrap: wrap; height: auto; padding-bottom: 6px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-open .cr-tc-hit { flex: 1 1 100%; height: var(--cr-tc-bar-h); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-ctl { flex-wrap: wrap; padding-left: 10px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-grip { display: none; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-row { flex-wrap: wrap; row-gap: 4px; padding-top: 4px; padding-bottom: 4px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-segs { flex: 1 1 100%; order: 5; flex-wrap: wrap; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-sev { min-width: 0; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-log { flex-basis: 100%; min-width: 0; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-tc-filters .cr-seg { flex-wrap: wrap; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-row { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
            /* the classic rule above makes every table a scroll box; CrTable has its own */
            body[data-layout="corporate"][data-corp-variant="redesigned"] table.cr-table { display: table; max-width: none; overflow: visible; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-grid { grid-template-columns: minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-main { flex-basis: 100%; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-meta { max-width: 100%; }
            /* the datastores stack: the storages above, their content below, each with its own scroll */
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds { flex-direction: column; height: auto !important; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-side { flex: 0 0 auto; max-height: 50vh; min-width: 0; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-main .cr-table-scroll { max-height: 70vh; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-head-side { margin-left: 0; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-head-cap, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap { flex-wrap: wrap; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ds-cap-wide .cr-meter-track { flex-basis: 90px; width: 90px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-status, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tiles { grid-template-columns: minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell + .cr-dc-cell { border-left: 0; border-top: 1px solid var(--cr-border-secondary); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-tiles, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-sched-grid { grid-template-columns: minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-link { flex-wrap: wrap; }
            /* the configuration dialog: one column, the panel keeps its count */
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-cols { grid-template-columns: minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-state { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-bar { padding: 8px 10px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-review { padding: 8px 10px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-mark > span[title] { max-width: 160px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-hw-cols, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-flag-grid { grid-template-columns: minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-flag-grp[data-cr-vc-flag-grp="crVcFlagGrpSec"] { grid-row: auto; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-topo { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-total { grid-column: 1 / -1; flex-direction: row; align-items: baseline; gap: 6px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-topo > .cr-vc-topo-op:nth-of-type(2) { display: none; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-numa-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-numa-key { grid-column: 1 / -1; padding-bottom: 0; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-choice { grid-template-columns: minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-tip-text { max-width: 220px; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-switches { grid-template-columns: minmax(0, 1fr); }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-card-acts { margin-left: 0; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-sec-acts { justify-content: flex-start; }
            /* the network of a node: the buttons under the title */
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nn-acts { margin-left: 0; }
            /* the actions of a node section and of its edit bar go under the title */
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-acts, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-editbar-acts, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nc-danger-acts { margin-left: 0; }
            /* the task and guest filters of a node wrap, the search takes the row */
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nt-filters .cr-seg { flex-wrap: wrap; }
            body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nt-filters .cr-search-box, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-nt-filters .cr-search-box .cr-input { width: 100%; }
        }
    </style>
</head>
<body class="dark notranslate">
    <script>
        // NS Apr 2026 (#342) — apply noise-off attribute as early as possible to
        // avoid a brief flash of the overlay on page load. localStorage flag set
        // by the toggle in user prefs.
        try { if (localStorage.getItem('pegaprox-noise') === 'off') document.body.setAttribute('data-noise', 'off'); } catch(_) {}
    </script>
    <div class="noise-overlay"></div>
    
    <!-- NS: Loading screen - shows immediately while Babel compiles -->
    <div id="loading-screen" style="
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #1a1a2e 0%, #0f0f1a 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    ">
        <div style="
            width: 80px;
            height: 80px;
            border: 3px solid rgba(226, 109, 65, 0.2);
            border-top-color: #e26d41;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        "></div>
        <div style="color: #e26d41; font-size: 24px; font-weight: 600; margin-top: 24px;">
            PegaProx
        </div>
        <div style="color: #888; font-size: 14px; margin-top: 8px;">
            Loading...
        </div>
    </div>
    <style>
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes sponsorNagPopIn {
            from { opacity: 0; transform: scale(0.85) translateY(20px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
    </style>
    
    <div id="root"></div>


    <!-- PEGAPROX_JSX_INSERT -->
    <!-- Build: cd web/Dev && ./build.sh -->

</body>
</html>
