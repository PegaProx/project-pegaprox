        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-note { flex-direction: row; align-items: center; font-size: 12px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-stat-row > .corp-overview-card { padding: 8px 12px; gap: 10px; background: var(--cr-bg-panel) !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
