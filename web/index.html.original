        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ns-item { display: flex; align-items: center; gap: 8px; padding: 5px 10px; font-size: 12.5px; color: var(--cr-text-primary); border: 1px solid var(--cr-border-secondary); border-left-width: 3px; border-radius: 3px; background: var(--cr-bg-panel); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ns-item > svg { flex: 0 0 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-ns-critical { border-color: var(--cr-error); background: var(--cr-error-soft); font-weight: 600; }
