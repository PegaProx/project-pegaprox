        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-title { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; min-width: 0; min-height: 22px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-name { margin: 0; overflow: hidden; font-size: 15px; font-weight: 600; line-height: 22px; color: var(--cr-text-primary); white-space: nowrap; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-objhead-id {
            padding: 1px 5px; font-family: var(--font-mono) !important; font-size: 11px; color: var(--cr-text-secondary);
