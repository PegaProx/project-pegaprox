        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-reserve dd { margin: 0; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-reserve-basis { display: flex; align-items: center; gap: 6px; grid-column: 1 / -1; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-capsec { display: flex; flex-direction: column; gap: 5px; padding-top: 8px; border-top: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-capsec-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-caprow { display: grid; grid-template-columns: minmax(70px, 1fr) minmax(80px, 110px) auto; align-items: center; gap: 2px 8px; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-capname { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-capslope { font-size: 11px; color: var(--cr-text-secondary); text-align: right; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-capeta { grid-column: 1 / -1; font-size: 11.5px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-cap .cr-ins-counts { gap: 2px 12px; font-size: 12px; }
        @media (max-width: 1180px) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-wi-top { grid-template-columns: minmax(0, 1fr); } }

        /* -- 22. Automation > Harden PVE Node: the bar, the progress, the control rows, the detail and the preview dialog (round 4) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; padding: 8px 10px; background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-field { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-field .cr-select { max-width: 260px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-report { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-progress { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 0 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-progress .cr-cmp-bar { flex: 1 1 auto; max-width: 520px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-progress-text { font-size: 12px; color: var(--cr-text-secondary); white-space: nowrap; font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-profile { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 1px 7px; font-size: 11.5px; color: var(--cr-accent); background: var(--cr-accent-soft); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-dropped { margin: 0 2px; font-size: 12px; color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-session-n { display: inline-block; margin-left: 10px; font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ref { font-family: var(--font-mono); font-size: 11.5px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-src-cis { color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ctl { display: flex; align-items: baseline; gap: 8px; min-width: 0; overflow: hidden; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ctl > .cr-strong { flex: 0 0 auto; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-desc { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: 11.5px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-flags { display: inline-flex; align-items: center; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-detail { display: flex; flex-direction: column; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-h { margin: 6px 0 0; font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-dl { display: grid; grid-template-columns: 136px minmax(0, 1fr); gap: 6px 12px; margin: 0; font-size: 12.5px; line-height: 1.45; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-dl dt { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-dl dd { margin: 0; min-width: 0; overflow-wrap: anywhere; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-why, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-note { display: block; margin-top: 3px; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-note { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-note-error { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-pre { margin: 0; max-height: 220px; overflow: auto; padding: 6px 8px; white-space: pre-wrap; word-break: break-all; font-family: var(--font-mono); font-size: 11.5px; color: var(--cr-text-primary); background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-cmd { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-params { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-top: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-param { display: inline-flex; align-items: center; gap: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-param .cr-input { width: 170px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-dismiss { margin-left: 8px; height: 22px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-dialog { width: min(820px, 100%); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-intro { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ptable-wrap { max-height: 300px; overflow: auto; border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ptable { width: 100%; border-collapse: collapse; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ptable th { position: sticky; top: 0; padding: 5px 8px; text-align: left; font-weight: 600; font-size: 11.5px; color: var(--cr-text-secondary); background: var(--cr-bg-secondary); border-bottom: 1px solid var(--cr-border-primary); white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ptable td { padding: 5px 8px; vertical-align: top; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ptable td:first-child { min-width: 260px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-ptable td:not(:first-child) { white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-plan-ref { display: block; font-size: 11px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-plan-what { display: block; margin-top: 2px; font-size: 11.5px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-yes { color: var(--cr-warning); white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-tick { display: flex; align-items: flex-start; gap: 8px; margin-top: 6px; font-size: 12.5px; line-height: 1.45; cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-tick input { margin-top: 2px; flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-hd-tick-warn { padding: 8px 10px; color: var(--cr-text-primary); background: var(--cr-warning-soft); border: 1px solid var(--cr-warning); border-radius: 3px; }

        /* -- 23. the alert strip under the header: one line per severity, the details under it (round 4) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-alerts { position: relative; z-index: 40; display: flex; flex-direction: column; background: var(--cr-bg-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-alerts:empty { display: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-row {
            display: flex; align-items: center; gap: 10px; min-width: 0; min-height: 30px; padding: 2px 6px 2px 9px; font-size: 12px;
            color: var(--cr-text-primary); border-bottom: 1px solid var(--cr-border-primary); border-left: 3px solid transparent;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-critical { background: var(--cr-error-soft); border-left-color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-warning { background: var(--cr-warning-soft); border-left-color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-info { background: var(--cr-info-soft); border-left-color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-state { background: var(--cr-neutral-soft); border-left-color: var(--cr-border-strong); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-row-chip { min-height: 28px; background: var(--cr-bg-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-sev { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; min-width: 104px; font-weight: 600; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-critical .cr-al-sev { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-warning .cr-al-sev { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-info .cr-al-sev { color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-state .cr-al-sev { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-ico svg { width: 15px; height: 15px; color: inherit; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-n {
            min-width: 18px; height: 18px; padding: 0 5px; font-size: 11px; line-height: 18px; text-align: center; font-variant-numeric: tabular-nums;
            color: var(--cr-text-primary); background: var(--cr-bg-panel); border-radius: 9px;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-segs { display: flex; align-items: center; gap: 6px; flex: 1 1 auto; min-width: 0; overflow: hidden; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-seg {
            flex: 0 1 auto; min-width: 0; max-width: 100%; height: 22px; padding: 0 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
            font: inherit; font-size: 12px; color: var(--cr-text-primary); background: var(--cr-bg-panel);
            border: 1px solid var(--cr-border-primary); border-radius: 3px; cursor: pointer;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-seg:hover { border-color: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-asof { flex-shrink: 0; font-size: 11.5px; white-space: nowrap; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-more { flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-more-gap { flex: 0 0 auto; width: 84px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-dismiss { width: 22px; height: 22px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-chip {
            display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 9px; font: inherit; font-size: 12px; font-weight: 600;
            color: var(--cr-error); background: var(--cr-error-soft); border: 1px solid var(--cr-error); border-radius: 11px; cursor: pointer;
        }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-detail { max-height: 40vh; overflow-y: auto; padding: 6px 12px 8px 12px; background: var(--cr-bg-panel); border-bottom: 1px solid var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-group + .cr-al-group { margin-top: 4px; padding-top: 4px; border-top: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-line { display: flex; align-items: flex-start; gap: 8px; padding: 4px 0; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-line > .cr-dot { flex-shrink: 0; margin-top: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-line > .cr-btn { flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-line-text { display: flex; flex-direction: column; gap: 1px; flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-msgs { display: flex; flex-direction: column; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-basis { font-size: 11px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-al-foot { margin: 6px 0 0; font-size: 11px; color: var(--cr-text-muted); }
        /* the sticky sidebar ends above the bottom bars while the strip takes its room at the top of the page */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-sidebar > .sticky { max-height: calc(100vh - var(--cr-header-h) - var(--cr-bottom-h) - var(--cr-alerts-h, 0px)) !important; }
        /* -- 24. Datacenter > Summary: the status of connection, quorum and infrastructure, the tiles and the node table (round 4) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-top { display: flex; align-items: center; gap: 8px; min-height: 22px; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-asof { display: inline-flex; align-items: center; gap: 6px; font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-top-gap { flex: 1 1 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-status { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 10px 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell + .cr-dc-cell { border-left: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell-head, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tile-head { display: flex; align-items: center; gap: 6px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell-ico svg, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tile-ico svg { width: 14px; height: 14px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-label { font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell-state { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; line-height: 1.3; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell-state > .cr-dot { width: 10px; height: 10px; flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tone-success { color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tone-warning { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tone-error { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tone-info { color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell-state.cr-dc-tone-neutral { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-cell-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-line { display: flex; align-items: baseline; gap: 6px; margin: 0; font-size: 12px; line-height: 1.45; color: var(--cr-text-secondary); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-line > .cr-dot { flex-shrink: 0; width: 7px; height: 7px; transform: translateY(-1px); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-line .cr-link { font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-votes { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; margin-top: 4px; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-votes .cr-btn .cr-spinner { width: 10px; height: 10px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-votes-out { overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tiles { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); overflow: hidden; background: var(--cr-bg-panel); border: 1px solid var(--cr-border-primary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tile { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 8px 12px 9px; box-shadow: 1px 0 0 var(--cr-border-secondary), 0 1px 0 var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tile-value { margin-left: auto; font-size: 18px; font-weight: 600; line-height: 1.2; color: var(--cr-text-primary); font-variant-numeric: tabular-nums; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tile-value.cr-dc-tone-warning { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tile-value.cr-dc-tone-error { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-bar { position: relative; display: block; height: 5px; overflow: hidden; background: var(--cr-bg-sunken); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-bar > span { position: absolute; left: 0; top: 0; bottom: 0; background: var(--cr-success); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-bar.cr-tone-warning > span { background: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-bar.cr-tone-error > span { background: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv { display: flex; flex-direction: column; gap: 1px; margin: 0; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv > div { display: flex; justify-content: space-between; gap: 8px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv dt { color: var(--cr-text-secondary); white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv dd { margin: 0; color: var(--cr-text-primary); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv > .cr-dc-tone-success dd { color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv > .cr-dc-tone-warning dd { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv > .cr-dc-tone-error dd { color: var(--cr-error); font-weight: 600; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-kv > .cr-dc-tone-info dd { color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-basis { margin: auto 0 0; padding-top: 2px; font-size: 11px; line-height: 1.35; color: var(--cr-text-muted); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-nodes .cr-panel-body { padding: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-nodes .cr-table-toolbar { padding: 6px 10px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-nodes-basis { font-size: 11.5px; }
        /* the table stays inside the window so its head and its own scroll are always at hand */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-nodes .cr-table-scroll { max-height: max(240px, calc(100vh - var(--cr-header-h) - var(--cr-bottom-h) - var(--cr-alerts-h, 0px) - 120px)); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-nodes tr.cr-dc-row-off > td:first-child { box-shadow: inset 3px 0 0 var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-nodes tr.cr-dc-row-off .cr-dc-node { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-nodes tr.cr-dc-row-nodata > td:first-child { box-shadow: inset 3px 0 0 var(--cr-border-strong); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-chips { display: inline-flex; flex-wrap: nowrap; gap: 4px; min-width: 0; overflow: hidden; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-chips .cr-badge { height: 17px; padding: 0 5px; font-size: 10.5px; }
        /* below 1500 px the six tiles take two rows of three */
        @media (max-width: 1499px) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-dc-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

        /* -- 25. Automation > Updates: the tiles, the three cards, the run, the start and schedule dialogs, a node's packages (round 4) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-tiles { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-tiles .cr-stat-sub { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-card { display: flex; flex-direction: column; gap: 6px; min-width: 0; padding: 10px 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-card-head { display: flex; align-items: center; gap: 8px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-card-head .cr-ico svg { width: 15px; height: 15px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-card-head .cr-panel-title { flex: 1 1 auto; min-width: 0; margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-card-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; margin-top: auto; padding-top: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-why { font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-line { margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--cr-text-primary); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-line .cr-spinner, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-actions .cr-spinner { vertical-align: -2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-text { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-bad { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-warn { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-copy { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-answer { display: flex; flex-direction: column; gap: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 3px 12px; margin: 0; font-size: 12.5px; line-height: 1.45; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-dl dt { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-dl dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-dl dd .cr-btn { margin-left: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run { display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; border-left: 3px solid var(--cr-border-strong); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-info { border-left-color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-warning { border-left-color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-error { border-left-color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-success { border-left-color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-head { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-acts { display: inline-flex; gap: 4px; margin-left: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-facts { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-bar { display: flex; height: 6px; overflow: hidden; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-bar-done { background: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-bar-fail { background: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chips { display: flex; flex-wrap: wrap; gap: 4px; margin: 0; padding: 0; list-style: none; max-height: 132px; overflow: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 7px; font-size: 11.5px; border: 1px solid var(--cr-border-secondary); border-radius: 3px; background: var(--cr-bg-panel); white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-st { color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-done { border-color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-done .cr-upd-chip-st { color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-failed { border-color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-failed .cr-upd-chip-st { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-current { border-color: var(--cr-info); background: var(--cr-info-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-current .cr-upd-chip-st { color: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chip-pending { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-list { margin: 4px 0 0; padding-left: 16px; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-run-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-failed { display: flex; flex-direction: column; gap: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-log summary { cursor: pointer; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-log pre { margin-top: 6px; max-height: 260px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-tab { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-guests { text-align: center; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-guests p { max-width: 640px; margin: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-hist-detail { display: flex; flex-direction: column; gap: 4px; padding: 6px 4px 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-hist-detail pre { max-height: 220px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-link { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-link > div { flex: 1 1 auto; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-link .cr-panel-title { margin: 0 0 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-link p { margin: 0; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-link > .cr-ico svg { width: 18px; height: 18px; color: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-dialog { width: min(680px, 100%); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-dialog-wide { width: min(1080px, 100%); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-tick, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-opt { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; line-height: 1.45; cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-tick input, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-opt input { margin-top: 2px; flex-shrink: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-opt-off { cursor: default; opacity: 0.75; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-opt-danger .cr-strong { color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-hint { display: block; font-size: 11.5px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-sub { display: flex; flex-direction: column; gap: 6px; margin-left: 22px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-field { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-field .cr-select { max-width: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-chan-list { display: inline-flex; flex-wrap: wrap; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-evac { padding: 6px 8px; font-size: 12px; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-start { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 14px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-start-nodes, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-start-opts { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; max-height: 300px; overflow: auto; border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order-row { display: flex; align-items: center; gap: 8px; min-height: 30px; padding: 2px 6px; font-size: 12.5px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order-row:last-child { border-bottom: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order-row[data-state="offline"] .cr-upd-order-name { color: var(--cr-text-muted); text-decoration: line-through; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order-name { flex: 0 0 auto; min-width: 70px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order-st { display: inline-flex; align-items: center; gap: 6px; flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order-move { display: inline-flex; flex: 0 0 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-order-move .cr-icon-btn { width: 24px; height: 24px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-advice, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-gates { display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-basis { margin-left: 6px; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-room { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-room-row { display: block; font-size: 12px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-gate-list { margin: 0; padding-left: 18px; font-size: 12px; line-height: 1.5; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-gate-not { color: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-sched-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-sched-grid .cr-upd-field { flex-direction: column; align-items: stretch; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-detail { display: flex; flex-direction: column; gap: 8px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs-wrap { max-height: calc(100vh - 380px); min-height: 120px; overflow: auto; border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs { width: 100%; border-collapse: collapse; font-size: 12px; table-layout: fixed; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs th { position: sticky; top: 0; padding: 4px 6px; text-align: left; font-weight: 600; font-size: 11px; color: var(--cr-text-secondary); background: var(--cr-bg-secondary); border-bottom: 1px solid var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs td { padding: 3px 6px; vertical-align: top; border-bottom: 1px solid var(--cr-border-secondary); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs th:nth-child(1) { width: 30%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs th:nth-child(4) { width: 15%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs th:nth-child(5) { width: 21%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-pkgs td .cr-badge { max-width: 100%; margin: 0 3px 2px 0; white-space: normal; height: auto; min-height: 18px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-ver { color: var(--cr-text-secondary); }
        /* below 1500 px the six tiles take two rows of three, the three cards stay side by side down to 1100 px */
        @media (max-width: 1499px) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
        @media (max-width: 1099px) { body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-cards, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-upd-start { grid-template-columns: minmax(0, 1fr); } }

        /* -- 26. the performance metrics of a node and a guest: the figures, the series toggles, the data quality, the groups, the observations (round 4) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-kpis { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-tile .cr-stat-sub { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-basis { font-size: 11px; line-height: 1.35; color: var(--cr-text-muted); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-tile[data-cr-pf-state="none"] .cr-stat-value { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-cell.cr-chart-more { display: flex; flex-direction: column; gap: 4px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-cell.cr-chart-more > div { height: auto; flex: 1 1 auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-series { display: flex; flex-wrap: wrap; gap: 4px; padding: 0 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-toggle { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; font-size: 11.5px; color: var(--cr-text-secondary); background: var(--cr-bg-panel); border: 1px solid var(--cr-border-secondary); border-radius: 3px; cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-toggle:hover { background: var(--cr-bg-hover); color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-toggle[aria-pressed="false"] { color: var(--cr-text-muted); text-decoration: line-through; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-toggle[aria-pressed="false"] .cr-chart-swatch { opacity: 0.35; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-swatch { display: inline-block; width: 14px; height: 0; border-top-width: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-chart-caption { padding: 0 2px; font-size: 11px; line-height: 1.35; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-quality { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; padding: 6px 2px 0; border-top: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-qline { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin: 0; font-size: 12px; line-height: 1.45; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-qline.cr-muted { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-note { margin: 0; font-size: 12px; line-height: 1.45; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-note .cr-spinner { margin-right: 6px; vertical-align: -2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-more { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-more-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-more-label { font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-group { padding: 8px 10px; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-group-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-group .cr-chart-cell > div { background: var(--cr-bg-panel) !important; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-acts { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 12px; font-size: 12px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-acts .cr-spinner { margin-right: 6px; vertical-align: -2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-check { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cr-text-secondary); cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-cmp-avgs { margin: 0; padding-left: 16px; font-size: 12px; line-height: 1.5; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-nics { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 12px; font-variant-numeric: tabular-nums; background: var(--cr-bg-panel); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-nics th, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-nics td { padding: 3px 6px; text-align: right; vertical-align: top; border-bottom: 1px solid var(--cr-border-secondary); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-nics thead th { padding: 3px 4px; font-size: 10.5px; font-weight: 600; line-height: 1.25; overflow-wrap: normal; color: var(--cr-text-secondary); background: var(--cr-bg-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-nics th:first-child { width: 16%; text-align: left; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-nics tbody th { font-weight: 500; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-nics td.cr-strong { font-weight: 700; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-delta { display: block; font-size: 11px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-notcollected { margin-top: 10px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-window { font-size: 11.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-obs { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-obs-row { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; line-height: 1.45; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-obs-text { display: flex; flex-direction: column; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-obs-basis { font-size: 11px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-dot { flex: 0 0 auto; width: 8px; height: 8px; margin-top: 5px; border-radius: 50%; background: var(--cr-border-strong); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-dot.cr-tone-warning { background: var(--cr-warning); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-dot.cr-tone-error { background: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-dot.cr-tone-info { background: var(--cr-info); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-pf-insights .cr-panel-body { display: flex; flex-direction: column; gap: 8px; }

        /* -- 27. the configuration dialog of a QEMU VM: the General tab in sections, the pending changes panel, the answer after a save, the other settings (round 5) -- */
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-general { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-cols { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 14px; align-items: start; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-sec { min-width: 0; background: var(--cr-bg-panel); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-sec-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 34px; padding: 6px 12px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-sec-title { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-sec-body { display: flex; flex-direction: column; gap: 12px; padding: 12px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 16px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-label-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; min-height: 16px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-label { font-size: 12px; font-weight: 500; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-input { width: 100%; height: 30px; font-size: 13px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-input.cr-vc-invalid, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-textarea.cr-vc-invalid { border-color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-hint { margin: 0; font-size: 11.5px; line-height: 1.4; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-error { margin: 0; font-size: 12px; line-height: 1.4; color: var(--cr-error); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-ro { display: flex; align-items: center; height: 30px; padding: 0 8px; font-size: 13px; color: var(--cr-text-primary); background: var(--cr-bg-secondary); border: 1px solid var(--cr-border-secondary); border-radius: 3px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-muted { font-size: 12px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-mark { display: inline-flex; align-items: center; gap: 6px; min-width: 0; font-size: 11.5px; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-mark > span[title] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 260px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-mark-dot { flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-link { padding: 0; font-size: 11.5px; color: var(--cr-accent); background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-link:hover { color: var(--cr-accent-hover); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-aside { display: inline-flex; align-items: center; gap: 10px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-state { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 8px 10px; background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-kv { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-kv > span { font-size: 11px; color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-kv > strong { font-size: 13px; font-weight: 600; color: var(--cr-text-primary); font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-kv > strong.cr-vc-ok { color: var(--cr-success); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-lock { display: flex; align-items: flex-start; gap: 10px; padding: 8px 10px; color: var(--cr-warning); background: var(--cr-warning-soft); border: 1px solid var(--cr-warning); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-lock-text { display: flex; flex-direction: column; gap: 2px; flex: 1 1 auto; min-width: 0; font-size: 12px; color: var(--cr-text-primary); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-tag { display: inline-flex; align-items: center; gap: 4px; height: 22px; padding: 0 4px 0 8px; font-size: 12px; color: var(--cr-text-primary); background: var(--cr-neutral-soft); border: 1px solid var(--cr-border-primary); border-radius: 11px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-tag-x { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; padding: 0; color: var(--cr-text-secondary); background: none; border: 0; border-radius: 50%; cursor: pointer; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-tag-x:hover { color: var(--cr-text-primary); background: var(--cr-bg-hover); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-tag-add { position: relative; display: inline-flex; flex: 1 1 180px; min-width: 150px; max-width: 320px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-tag-add .cr-input { width: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-suggest { position: absolute; left: 0; right: 0; top: calc(100% + 4px); z-index: 61; max-height: 180px; overflow-y: auto; padding: 4px 0; background: var(--cr-bg-elevated); border: 1px solid var(--cr-border-primary); border-radius: 4px; box-shadow: var(--cr-shadow-pop); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-textarea { width: 100%; min-height: 140px; padding: 8px; font-size: 13px; line-height: 1.5; color: var(--cr-text-primary); background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-primary); border-radius: 3px; outline: none; resize: vertical; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-textarea:focus { border-color: var(--cr-accent); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md { display: block; width: 100%; min-height: 80px; padding: 8px 10px; font-size: 13px; line-height: 1.5; text-align: left; color: var(--cr-text-primary); background: var(--cr-bg-sunken); border: 1px solid var(--cr-border-secondary); border-radius: 3px; cursor: text; overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md p { margin: 4px 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md a { color: var(--cr-accent); text-decoration: underline; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md code { padding: 1px 4px; font-size: 0.9em; background: var(--cr-bg-panel); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md pre { padding: 8px; overflow-x: auto; background: var(--cr-bg-panel); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md table { border-collapse: collapse; margin: 6px 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md th, body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md td { padding: 4px 8px; border: 1px solid var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-md img { max-width: 100%; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-count { font-size: 11px; color: var(--cr-text-muted); text-align: right; font-variant-numeric: tabular-nums; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-panel { flex: 0 0 auto; display: flex; flex-direction: column; min-width: 0; background: var(--cr-bg-secondary); border-top: 1px solid var(--cr-border-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; min-height: 48px; padding: 8px 16px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-sum { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; min-width: 0; font-size: 12.5px; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-left: auto; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-chip { display: inline-flex; align-items: center; height: 20px; padding: 0 8px; font-size: 11px; font-weight: 500; white-space: nowrap; border-radius: 10px; color: var(--cr-text-secondary); background: var(--cr-neutral-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-chip-warn { color: var(--cr-warning); background: var(--cr-warning-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-chip-error { color: var(--cr-error); background: var(--cr-error-soft); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-review { display: flex; flex-direction: column; gap: 10px; max-height: 42vh; overflow-y: auto; padding: 10px 16px; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-list { display: flex; flex-direction: column; gap: 0; margin: 0; padding: 0; list-style: none; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-row { padding: 7px 0; border-bottom: 1px solid var(--cr-border-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-row:last-child { border-bottom: 0; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-row-main { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; min-width: 0; font-size: 12.5px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-row-label { font-weight: 600; color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-row-key { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-row-val { min-width: 0; max-width: 100%; color: var(--cr-text-secondary); overflow-wrap: anywhere; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-new { color: var(--cr-text-primary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-arrow { color: var(--cr-text-muted); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-why { margin: 3px 0 0; font-size: 12px; line-height: 1.45; color: var(--cr-text-secondary); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-block { display: flex; flex-direction: column; gap: 4px; padding: 8px 10px; font-size: 12px; line-height: 1.45; color: var(--cr-text-primary); background: var(--cr-bg-panel); border: 1px solid var(--cr-border-secondary); border-radius: 3px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-block ul { margin: 0; padding-left: 18px; }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-block-error { margin: 8px 16px 0; color: var(--cr-text-primary); background: var(--cr-error-soft); border-color: var(--cr-error); }
        body[data-layout="corporate"][data-corp-variant="redesigned"] .cr-vc-block-wait { margin: 8px 16px 0; }
