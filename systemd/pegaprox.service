[Unit]
Description=PegaProx - Proxmox Datacenter Manager for Proxmox VE
After=network-online.target
Wants=network-online.target
# MK #633: TLS bootstrap now fails closed (won't serve plaintext on the TLS port).
# Bound the restarts so a permanently-broken cert lands in a clear `failed` state
# an operator notices, instead of an endless 5s crash-loop. Transient failures
# still get 5 quick retries within the window.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pegaprox
Group=pegaprox
WorkingDirectory=/var/lib/pegaprox
# NS Nov 2026 (#1226): as root, before every start, the master key goes to /etc/pegaprox
# (packaging/debian/master_key.py), so a first start with SQLCipher never makes one next
# to the database. Where it cannot tell which key a database needs, the start fails here.
ExecStartPre=+/usr/bin/python3 -I -B /usr/lib/pegaprox/packaging/debian/master_key.py \
    --key /etc/pegaprox/secret.key --state-dir /var/lib/pegaprox --user pegaprox --unit pegaprox.service
ExecStart=/usr/bin/pegaprox/pegaprox-wrapper

Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pegaprox

[Install]
WantedBy=multi-user.target