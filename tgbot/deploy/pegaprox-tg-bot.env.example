# Token from @BotFather
TG_BOT_TOKEN=123456:ABC...
# Where PegaProx listens. On the same host/LXC this is the default.
PEGAPROX_URL=https://127.0.0.1:5000
# false for a self-signed certificate on localhost, true or a CA bundle path otherwise
PEGAPROX_VERIFY_TLS=false
# Optional: only these Telegram user ids may use the bot (comma separated)
TG_ALLOWED_IDS=
# Seconds between checks for new alerts (0 = no notifications)
TG_ALERT_POLL=60
# Where linked accounts are kept (systemd StateDirectory)
TG_DATA_DIR=/var/lib/pegaprox-tg-bot
