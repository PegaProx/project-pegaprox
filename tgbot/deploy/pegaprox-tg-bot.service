[Unit]
Description=Telegram bot for PegaProx
After=network-online.target pegaprox.service
Wants=network-online.target

[Service]
Type=simple
User=pegaprox-tg-bot
Group=pegaprox-tg-bot
WorkingDirectory=/opt/pegaprox-tg-bot
ExecStart=/opt/pegaprox-tg-bot/venv/bin/python -m tgbot --env /etc/pegaprox-tg-bot.env
Restart=on-failure
RestartSec=10
StateDirectory=pegaprox-tg-bot
StateDirectoryMode=0700
NoNewPrivileges=true
# The whole file system is read-only for the bot except its StateDirectory
# (/var/lib/pegaprox-tg-bot). For another TG_DATA_DIR add a drop-in with
# `systemctl edit pegaprox-tg-bot`:
#   [Service]
#   ReadWritePaths=/path/to/data
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
