{
  "id": null,
  "uid": "pegaprox-node-health",
  "title": "PegaProx Node Health",
  "description": "Version: 1.0 | Node clock offset, temperature, measured power and pressure stall information from the PegaProx exporter",
  "tags": [
    "pegaprox",
    "proxmox",
    "nodes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(pegaprox_cluster_connected, cluster)",
        "definition": "label_values(pegaprox_cluster_connected, cluster)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(pegaprox_node_online{cluster=~\"$cluster\"}, node)",
        "definition": "label_values(pegaprox_node_online{cluster=~\"$cluster\"}, node)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Largest clock offset",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(abs(pegaprox_node_clock_offset_seconds{cluster=~\"$cluster\"}))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Node clock minus the PegaProx clock. Proxmox answers whole seconds, so read it as about +/-0.5 s plus half the round trip."
    },
    {
      "type": "stat",
      "title": "Hottest node",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(pegaprox_node_temperature_celsius{cluster=~\"$cluster\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Hottest sensor of any node, from the 5-minute hardware poll."
    },
    {
      "type": "stat",
      "title": "Measured power draw",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(pegaprox_node_power_watts{cluster=~\"$cluster\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "description": "Sum of what the BMCs report, for the nodes whose BMC PegaProx reads."
    },
    {
      "type": "stat",
      "title": "Clock and pressure reads complete",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(pegaprox_cluster_source_up{cluster=~\"$cluster\", source=~\"clock|node_pressure\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "red"
                },
                "1": {
                  "text": "YES",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Clock offset per node",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pegaprox_node_clock_offset_seconds{cluster=~\"$cluster\", node=~\"$node\"}",
          "refId": "A",
          "legendFormat": "{{cluster}} / {{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Temperature per node",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pegaprox_node_temperature_celsius{cluster=~\"$cluster\", node=~\"$node\"}",
          "refId": "A",
          "legendFormat": "{{cluster}} / {{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Power draw per node",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pegaprox_node_power_watts{cluster=~\"$cluster\", node=~\"$node\"}",
          "refId": "A",
          "legendFormat": "{{cluster}} / {{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "watt",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU pressure per node (some)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pegaprox_node_pressure_some_percent{cluster=~\"$cluster\", node=~\"$node\", resource=\"cpu\"}",
          "refId": "A",
          "legendFormat": "{{cluster}} / {{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "description": "Share of time in which some tasks waited for a CPU (10 s average, Proxmox VE 9)."
    },
    {
      "type": "timeseries",
      "title": "Memory pressure per node",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pegaprox_node_pressure_some_percent{cluster=~\"$cluster\", node=~\"$node\", resource=\"memory\"}",
          "refId": "A",
          "legendFormat": "{{node}} some"
        },
        {
          "expr": "pegaprox_node_pressure_full_percent{cluster=~\"$cluster\", node=~\"$node\", resource=\"memory\"}",
          "refId": "B",
          "legendFormat": "{{node}} full"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "description": "some: at least one task waited for memory; full: every non-idle task did."
    },
    {
      "type": "timeseries",
      "title": "IO pressure per node",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pegaprox_node_pressure_some_percent{cluster=~\"$cluster\", node=~\"$node\", resource=\"io\"}",
          "refId": "A",
          "legendFormat": "{{node}} some"
        },
        {
          "expr": "pegaprox_node_pressure_full_percent{cluster=~\"$cluster\", node=~\"$node\", resource=\"io\"}",
          "refId": "B",
          "legendFormat": "{{node}} full"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Nodes now",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "pegaprox_node_clock_offset_seconds{cluster=~\"$cluster\", node=~\"$node\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "pegaprox_node_temperature_celsius{cluster=~\"$cluster\", node=~\"$node\"}",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "pegaprox_node_power_watts{cluster=~\"$cluster\", node=~\"$node\"}",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "pegaprox_node_pressure_some_percent{cluster=~\"$cluster\", node=~\"$node\", resource=\"io\"}",
          "refId": "D",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "A: clock offset (s), B: hottest sensor (C), C: power (W), D: IO pressure some (%)."
    }
  ]
}
