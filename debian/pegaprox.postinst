#!/bin/bash
set -e

if [ "$1" = "configure" ]; then

    if ! id "pegaprox" &>/dev/null; then
        useradd --system --home /usr/lib/pegaprox --create-home --shell /usr/sbin/nologin --group nogroup pegaprox
        echo "User 'pegaprox' created."
    else
        echo "User 'pegaprox' already exists, skipping creation."
    fi

    if [ ! -d /var/lib/pegaprox ]; then
        mkdir -p /var/lib/pegaprox
    fi

    chown pegaprox:pegaprox /var/lib/pegaprox
    chmod 750 /var/lib/pegaprox
    # NB: .ssh_ws_server.py is NOT shipped in the package and is NOT written here —
    # it's generated at runtime into a writable dir (the package's api/ is root-owned
    # read-only for the service user, so vms.py falls back to a temp dir). The old
    # chown/chmod on it was a leftover from when it was tracked (54dbca4) and made the
    # postinst — and thus the whole appliance build — fail with "cannot access".

    # NS Oct 2026 (#1134): the service loads its plugins from its working directory, and
    # the package never brought any there. On every install and upgrade the shipped ones
    # go in: their code replaced, a plugin's config.json and a plugin the admin added
    # left alone. A plugin that does not make it is no reason to fail the upgrade.
    /usr/bin/python3 /usr/lib/pegaprox/packaging/plugins/sync_plugins.py \
        /usr/share/pegaprox/plugins /var/lib/pegaprox/plugins --owner pegaprox:pegaprox \
        || echo "pegaprox: not every bundled plugin could be brought into /var/lib/pegaprox/plugins (see above)" >&2

    systemctl enable pegaprox.service
    systemctl restart pegaprox.service || true

fi

# The debhelper part enables and starts the unit, so it goes after the user and the
# state directory exist. Ahead of them every first start failed with 217/USER (#1129).
#DEBHELPER#
