{
  "_about": "What the release watchdog (.github/scripts/watchdog.py) expects. Change it on Testing like code; it takes effect when it reaches main. docs/release-watchdog.md says how.",
  "repo": "PegaProx/project-pegaprox",
  "default_branch": "main",
  "branches": [
    "main",
    "Testing"
  ],
  "_about_roles": "allowed_actors may push or merge to Testing and start publishers; release_managers may also move main, create v* tags and publish releases (since July only these two did); watchdog_maintainers may push a change to watchdog.yml, watchdog.py or baseline.json",
  "allowed_actors": [
    "MrMasterbay",
    "mkellermann97",
    "gyptazy",
    "Ghoszbust3r"
  ],
  "release_managers": [
    "MrMasterbay",
    "mkellermann97"
  ],
  "watchdog_maintainers": [
    "MrMasterbay"
  ],
  "collaborators": {
    "MrMasterbay": "admin",
    "mkellermann97": "write",
    "Ghoszbust3r": "write"
  },
  "allowed_authors": {
    "_about": "who may author a commit that changes a guarded path: a GitHub login, or the commit email for an author without an account",
    "logins": [
      "MrMasterbay",
      "mkellermann97",
      "gyptazy",
      "Ghoszbust3r"
    ],
    "emails": [
      "laura.weber@pegaprox.com"
    ]
  },
  "guarded_paths": [
    ".github/workflows/",
    ".github/scripts/",
    ".github/watchdog/",
    "packaging/apt/"
  ],
  "release_asset_uploaders": [
    "github-actions[bot]"
  ],
  "workflows": {
    "publishers": {
      "apt-repo.yml": "signs and deploys apt.pegaprox.com (Pages) and attaches the .deb to the release",
      "docker-testing.yml": "pushes ghcr.io/pegaprox/pegaprox-testing on every Testing push",
      "docker.yml": "pushes the release images to ghcr.io and Docker Hub",
      "release-images.yml": "attaches the VM and LXC appliance images to the release",
      "sbom.yml": "attaches the SBOM to the release"
    },
    "attach_to_releases": [
      "apt-repo.yml",
      "release-images.yml",
      "sbom.yml"
    ],
    "others": {
      "image-catalog-check.yml": "HEADs the cloud-init image URLs, publishes nothing",
      "issue-validator.yml": "labels and closes incomplete issues",
      "pr-target-guard.yml": "moves PRs from main to Testing",
      "pr-template-check.yml": "comments on PRs with an empty template",
      "push-create-snapshot-deb-builds.yml": "a snapshot .deb as a run artifact for 14 days; no release, no package registry, no APT repo",
      "test.yml": "runs the tests",
      "watchdog.yml": "this watchdog"
    }
  },
  "accepted_main_heads": {},
  "accepted_releases": {
    "337662652": "0.9.12.3 of 2026-06-11: published by a workflow (github-actions[bot]) on a tag without the v"
  },
  "settings": {
    "default_branch": "main",
    "visibility": "public",
    "archived": false,
    "disabled": false,
    "has_pages": true
  },
  "update_manifest": {
    "_about": "the URL fields of version.json the updater and the UI read (pegaprox/api/settings.py, pegaprox/constants.py, update.sh)",
    "branches": [
      "main",
      "Testing"
    ],
    "mirror": "https://updates.pegaprox.com/version.json",
    "exact": {
      "update_archive": [
        "https://github.com/PegaProx/project-pegaprox/archive/refs/heads/main.tar.gz",
        "https://updates.pegaprox.com/archive/main.tar.gz"
      ],
      "update_mirror": [
        "https://updates.pegaprox.com"
      ]
    },
    "prefixes": {
      "download_url": [
        "https://github.com/PegaProx/project-pegaprox/"
      ]
    },
    "other_url_prefixes": [
      "https://github.com/PegaProx/project-pegaprox/",
      "https://updates.pegaprox.com/"
    ]
  },
  "environments": {
    "apt-signing": {
      "deployment_branch_policy": {
        "custom_branch_policies": true,
        "protected_branches": false
      },
      "branch_policies": [
        [
          "main",
          "branch"
        ],
        [
          "v*",
          "tag"
        ]
      ]
    },
    "github-pages": {
      "deployment_branch_policy": {
        "custom_branch_policies": true,
        "protected_branches": false
      },
      "branch_policies": [
        [
          "main",
          "branch"
        ],
        [
          "v*",
          "tag"
        ]
      ]
    }
  },
  "pages": {
    "cname": "apt.pegaprox.com",
    "build_type": "workflow"
  },
